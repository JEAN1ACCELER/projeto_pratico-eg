direction: right

CamadaApresentacao: "Camada de Apresentação (Frontend)" {
  shape: rectangle
  PWA: "React PWA"
}

CamadaAplicacao: "Camada de Aplicação (Backend)" {
  shape: rectangle
  API: "Node.js/Express API"
}

CamadaDominio: "Camada de Domínio" {
  shape: rectangle
  Entidades: "Entidades de Negócio"
  Regras: "Regras de Negócio"
}

CamadaInfraestrutura: "Camada de Infraestrutura" {
  shape: rectangle
  DB: "PostgreSQL"
  Auth: "Firebase Auth"
  ServicosExternos: "Serviços Externos"
}

CamadaApresentacao -> CamadaAplicacao: "Requisições REST"
CamadaAplicacao -> CamadaDominio: "Usa"
CamadaDominio -> CamadaInfraestrutura: "Usa"

CamadaApresentacao.PWA <-> CamadaAplicacao.API: "Comunicação"

CamadaAplicacao.API -> CamadaDominio.Entidades: "Gerencia"
CamadaAplicacao.API -> CamadaDominio.Regras: "Aplica"

CamadaInfraestrutura.DB <-> CamadaDominio.Entidades: "Persiste"
CamadaInfraestrutura.Auth <-> CamadaAplicacao.API: "Autentica"
CamadaInfraestrutura.ServicosExternos <-> CamadaAplicacao.API: "Integra"

CamadaApresentacao.PWA.MVC: "MVC (Frontend)" {
  shape: rectangle
  View: "Componentes React (View)"
  Model: "Estado da Aplicação (Model)"
  Controller: "Handlers de Eventos (Controller)"
}

CamadaAplicacao.API.MVC: "MVC (Backend)" {
  shape: rectangle
  Controller: "Controllers (Controller)"
  Model: "Services (Model)"
  View: "Serialização JSON (View)"
}



