direction: right

system EProject "E-Project" {
  description: "Sistema de Gestão de Projetos de Pesquisa e Extensão"
}

person Professor "Professor Orientador" {
  description: "Gerencia projetos, tarefas, orientandos e documentos."
}

person Estudante "Estudante Orientando" {
  description: "Realiza tarefas, submete entregas, faz check-in e visualiza feedback."
}

person Administrador "Administrador" {
  description: "Responsável por configurações gerais do sistema e gerenciamento de usuários."
}

person UsuarioAcessibilidade "Usuário com Necessidades Especiais" {
  description: "Interage com o sistema utilizando recursos de acessibilidade."
}

externalsystem EmailSystem "Sistema de E-mail" {
  description: "Envia notificações e comunicações gerais."
}

externalsystem UFAMSystem "Sistema da UFAM" {
  description: "Sistema acadêmico ou de gestão de editais."
}

externalsystem AuthSystem "Sistema de Autenticação Institucional (SSO)" {
  description: "Autentica usuários com credenciais institucionais."
}

Professor -> EProject: "Gerencia projetos e orientandos"
Estudante -> EProject: "Interage com tarefas e entregas"
Administrador -> EProject: "Administra o sistema"
UsuarioAcessibilidade -> EProject: "Utiliza recursos de acessibilidade"

EProject -> EmailSystem: "Envia notificações"
EProject -> UFAMSystem: "Consulta/Integra dados"
EProject -> AuthSystem: "Autentica usuários"
