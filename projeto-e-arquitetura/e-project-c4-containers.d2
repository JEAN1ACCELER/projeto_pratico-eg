direction: right

enterprise "E-Project" {
  system EProject "E-Project" {
    container WebApp "Aplicação Web" {
      description: "Frontend (React PWA)"
      technology: "React, PWA"
    }

    container Api "API REST" {
      description: "Backend (Node.js/Express)"
      technology: "Node.js, Express"
    }

    container Database "Banco de Dados" {
      description: "Persistência de dados"
      technology: "PostgreSQL"
    }
  }

  system ExternalSystems "Sistemas Externos" {
    container FirebaseAuth "Firebase Authentication" {
      description: "Serviço de autenticação"
      technology: "Firebase"
    }

    container EmailSystem "Sistema de E-mail" {
      description: "Envio de notificações"
      technology: "SMTP/HTTP/S"
    }

    container UFAMSystem "Sistema da UFAM" {
      description: "Integração de dados acadêmicos"
      technology: "API ou outros"
    }
  }
}

WebApp -> Api: "Usa (HTTP/S)"
Api -> Database: "Lê/Escreve (SQL)"
Api -> FirebaseAuth: "Autentica usuários (HTTP/S)"
Api -> EmailSystem: "Envia e-mails (HTTP/S)"
Api -> UFAMSystem: "Consulta/Integra dados (HTTP/S)"
